{
  "endOfLine": "lf",
  "printWidth": 100,
  "arrowParens": "always",
  "bracketSpacing": true,
  "semi": true,
  "singleQuote": false,
  "tabWidth": 4,
  "trailingComma": "none",
  "useTabs": true,
  "overrides": [
    {
      "files": ["**/*.{yml,json}", ".prettierrc"],
      "options": { "useTabs": false, "tabWidth": 2 }
    }
  ]
}
